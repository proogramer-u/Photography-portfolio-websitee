# Use the project base URL only; do not append /rest/v1/.
VITE_SUPABASE_URL=https://your-project.supabase.co
# A browser-safe publishable key is also supported. Never use a secret/service-role key.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Single-owner username alias for an existing Supabase Auth email/password account.
# VITE_ values are browser-visible; these identifiers are not secret credentials.
VITE_ADMIN_USERNAME=your-username
VITE_ADMIN_EMAIL=owner@example.com
